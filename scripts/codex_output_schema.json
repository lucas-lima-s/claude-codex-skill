{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClaudeCodexReviewResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "severity", "confidence", "summary", "findings", "block_recommended", "coverage", "questions"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ok", "needs_input"],
      "description": "needs_input only when the review cannot proceed without an answer."
    },
    "questions": {
      "type": "array",
      "description": "Blocking questions when status=needs_input; empty array otherwise.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "context"],
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "context": {
            "type": "string"
          }
        }
      }
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "summary": {
      "type": "string",
      "description": "One-paragraph summary of the review."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "category", "title", "detail", "location"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "category": {
            "type": "string",
            "description": "Short category tag; empty string when not applicable."
          },
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "location": {
            "type": "string",
            "description": "file:line, file, or empty string when not applicable."
          }
        }
      }
    },
    "block_recommended": {
      "type": "boolean",
      "description": "Only true when severity=high and confidence=high."
    },
    "coverage": {
      "type": "array",
      "description": "One entry per checklist category swept, including those with zero findings. Empty array in modes that have no checklist.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "findings_count"],
        "properties": {
          "category": {
            "type": "string"
          },
          "findings_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
